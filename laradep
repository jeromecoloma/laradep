get_predefined_message() {
  local message_type="$1"
  local env="$2"
  local release="$3"
  
  case "$message_type" in
    deploy)
      echo "🚀 Deployment completed successfully to *${env}* environment"
      ;;
    rollback)
      echo "⏪ Rolled back to release \`${release}\` on *${env}* environment"
      ;;
    maintenance)
      echo "🔧 System maintenance window started on *${env}* environment"
      ;;
    maintenance-down)
      echo "🔧 *${env}* environment is now in maintenance mode"
      ;;
    maintenance-up)
      echo "✅ *${env}* environment is back online - maintenance completed"
      ;;
    hotfix)
      echo "🆘 Emergency hotfix deployed to *${env}* environment"
      ;;
    release)
      echo "📦 New release \`${release}\` deployed to *${env}* environment"
      ;;
    alert)
      echo "🚨 Alert: Deployment issue detected on *${env}* environment"
      ;;
    setup)
      echo "⚙️ Initial setup completed for *${env}* environment"
      ;;
    purge)
      echo "♻️ Cloudflare cache purged for *${env}* environment"
      ;;
    *)
      echo "📋 Deployment notification for *${env}* environment"
      ;;
  esac
}

