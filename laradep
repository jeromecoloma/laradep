# CONFIGURATION DETECTION
# =============================================================================

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

normalize_existing_path() {
    local path="$1"

    if [ -d "$path" ]; then
        (cd "$path" 2>/dev/null && pwd -P)
        return $?
    fi

    if [ -e "$path" ]; then
        local parent_dir
        parent_dir="$(dirname "$path")"
        local base_name
        base_name="$(basename "$path")"
        parent_dir="$(cd "$parent_dir" 2>/dev/null && pwd -P)" || return 1
        echo "$parent_dir/$base_name"
        return 0
    fi

    return 1
}

is_within_dir() {
    local child="$1"
    local parent="$2"
    case "$child/" in
        "$parent/"*) return 0 ;;
        *) return 1 ;;
    esac
}

resolve_upload_source_path() {
    local src="$1"
    local trailing_slash=""
    [[ "$src" == */ ]] && trailing_slash="/"

    if [[ -z "$src" ]]; then
        echo "$src"
        return 0
    fi

    if [[ "$src" == /* ]]; then
        echo "$src"
        return 0
    fi

    local project_root_abs=""
    project_root_abs="$(normalize_existing_path "$PROJECT_ROOT" 2>/dev/null || true)"

    local config_dir_abs=""
    config_dir_abs="$(normalize_existing_path "$CONFIG_DIR" 2>/dev/null || true)"

    local pwd_abs=""
    pwd_abs="$(normalize_existing_path "$(pwd)" 2>/dev/null || true)"

    local candidate normalized

    if [[ -n "$project_root_abs" ]]; then
        candidate="$project_root_abs/$src"
        normalized="$(normalize_existing_path "$candidate" 2>/dev/null || true)"
        if [[ -n "$normalized" ]] && is_within_dir "$normalized" "$project_root_abs"; then
            echo "${normalized%/}${trailing_slash}"
            return 0
        fi
    fi

    if [[ -n "$config_dir_abs" ]]; then
        candidate="$config_dir_abs/$src"
        normalized="$(normalize_existing_path "$candidate" 2>/dev/null || true)"
        if [[ -n "$normalized" ]] && { [[ -z "$project_root_abs" ]] || is_within_dir "$normalized" "$project_root_abs"; }; then
            echo "${normalized%/}${trailing_slash}"
            return 0
        fi
    fi

    if [[ -n "$pwd_abs" ]]; then
        candidate="$pwd_abs/$src"
        normalized="$(normalize_existing_path "$candidate" 2>/dev/null || true)"
        if [[ -n "$normalized" ]] && { [[ -z "$project_root_abs" ]] || is_within_dir "$normalized" "$project_root_abs"; }; then
            echo "${normalized%/}${trailing_slash}"
            return 0
        fi
    fi

    if [[ -n "$config_dir_abs" ]]; then
        candidate="$config_dir_abs/$src"
        normalized="$(normalize_existing_path "$candidate" 2>/dev/null || true)"
        if [[ -n "$normalized" ]]; then
            echo "${normalized%/}${trailing_slash}"
            return 0
        fi
    fi

    if [[ -n "$project_root_abs" ]]; then
        candidate="$project_root_abs/$src"
        normalized="$(normalize_existing_path "$candidate" 2>/dev/null || true)"
        if [[ -n "$normalized" ]]; then
            echo "${normalized%/}${trailing_slash}"
            return 0
        fi
    fi

    if [[ -n "$pwd_abs" ]]; then
        candidate="$pwd_abs/$src"
        normalized="$(normalize_existing_path "$candidate" 2>/dev/null || true)"
        if [[ -n "$normalized" ]]; then
            echo "${normalized%/}${trailing_slash}"
            return 0
        fi
    fi

    echo "${project_root_abs:-$(pwd)}/$src"
    return 0
}

detect_config_directory() {
    # Try to find deployment configs in common locations
    # Priority 1: Git root directory (if we're in a git repository)
    local git_root=""
    if git rev-parse --git-dir > /dev/null 2>&1; then
        git_root="$(git rev-parse --show-toplevel)"
        if [ -d "$git_root/_scripts" ] && ([ -f "$git_root/_scripts/rsync.cfg" ] || [ -f "$git_root/_scripts/rsync-staging.cfg" ]); then
            echo "$git_root/_scripts"
            return 0
        fi
    fi
    
    # Priority 2: Other common locations
    local possible_dirs=(
        "$(pwd)/_scripts"
        "$(pwd)/scripts" 
        "$(pwd)/.deploy"
        "$HOME/.deploy"
        "$SCRIPT_DIR/../configs"
        "$SCRIPT_DIR/configs"
    )
    
    for dir in "${possible_dirs[@]}"; do
        if [ -d "$dir" ] && ([ -f "$dir/rsync.cfg" ] || [ -f "$dir/rsync-staging.cfg" ]); then
            echo "$dir"
            return 0
        fi
    done
    
    # Fallback: current directory
    echo "$(pwd)"
}

CONFIG_DIR="$(detect_config_directory)"

# Derive project root from config directory
if [[ "$CONFIG_DIR" == */_scripts ]]; then
  PROJECT_ROOT="${CONFIG_DIR%/_scripts}"
elif [[ "$CONFIG_DIR" == */scripts ]]; then
  PROJECT_ROOT="${CONFIG_DIR%/scripts}"
elif [[ "$CONFIG_DIR" == */.deploy ]]; then
  PROJECT_ROOT="${CONFIG_DIR%/.deploy}"
else
  PROJECT_ROOT="$(pwd)"
fi

