  echo -e "${C4}▶ The 'setup' command is designed for INITIAL server preparation only.${CE}"
  echo -e "${C4}▶ Running setup on an existing deployment can cause issues or overwrite configurations.${CE}"
  echo -e "${C4}▶ This command will create/modify server directories and symlinks.${CE}"
  echo ""
